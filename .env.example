# The server does not automatically load this file. Copy these values into your
# shell, process manager, or hosting-provider environment.
HOST=0.0.0.0
PORT=3000
DATA_DIR=./data
HEX_TRUST_PROXY=false
HEX_ALLOWED_ORIGINS=
HEX_AUTH_ATTEMPTS_PER_MINUTE=12
HEX_WS_MAX_PAYLOAD=50331648

# Built-in administrator account:
#   Username: Benleethom
#   Player name: Ben
# Set a strong password here in Railway before deployment. When omitted on the
# first production start, a random temporary password is printed once in logs.
HEX_BUILTIN_ADMIN_ENABLED=true
HEX_ADMIN_PASSWORD=
# Set true for one restart only when the environment password should overwrite
# a password Ben changed from the in-game account screen.
HEX_ADMIN_FORCE_PASSWORD_SYNC=false

# Public account-recovery links. Use the exact public origin of the game.
HEX_PUBLIC_BASE_URL=
HEX_EMAIL_FROM=Hex Settlers <no-reply@example.com>

# Recommended free option: Resend's HTTPS API. Verify the sender domain in
# Resend, create a sending-only API key, and store it only in Railway.
HEX_EMAIL_MODE=resend
RESEND_API_KEY=
RESEND_TIMEOUT_MS=15000

# Optional paid Cloudflare Email Service bridge.
HEX_EMAIL_CLOUDFLARE_ENDPOINT=
HEX_EMAIL_BRIDGE_SECRET=
HEX_EMAIL_BRIDGE_TIMEOUT_MS=15000

# Email delivery option 2: SMTP. Leave SMTP_HOST blank when using Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REQUIRE_TLS=true
SMTP_ALLOW_SELF_SIGNED=false
SMTP_TIMEOUT_MS=15000

# Simulation-only acceleration. Do not enable for normal hosted games.
AI_FAST=0

# Optional passwordless sign-in providers. Store these only as backend/Cloudflare
# Worker secrets, never in public assets or wrangler vars. Use the same 32+
# character OAUTH_STATE_SECRET on every serving instance.
OAUTH_STATE_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_CLOUDFLARE_CLIENT_ID=
OAUTH_CLOUDFLARE_CLIENT_SECRET=
# Cloudflare's API user identity permission; must match your OAuth client.
OAUTH_CLOUDFLARE_SCOPES=user-details.read
