{
  "name": "hex-settlers",
  "version": "1.0.57",
  "private": true,
  "description": "Online hex-settlement strategy game with classic and seafaring maps, multiplayer, and AI opponents.",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "start:legacy": "node server.js",
    "build": "tsc -p tsconfig.bootstrap.json && npm run build:discord",
    "build:bootstrap": "tsc -p tsconfig.bootstrap.json",
    "test": "node --test",
    "test:integration": "node --test test/server.integration.test.js",
    "check": "tsc -p tsconfig.bootstrap.json && node --test && node --check server.js && node --check public/app.js",
    "electron:start": "npm --prefix desktop run start",
    "electron:dist": "npm --prefix desktop run dist --",
    "build:discord": "node scripts/build-discord.cjs && node scripts/verify-discord-bundle.cjs",
    "check:discord-bundle": "node scripts/verify-discord-bundle.cjs",
    "train:neural": "node scripts/train_neural_ai_all_maps.js",
    "train:neural:smoke": "node scripts/train_neural_ai_smoke.js",
    "train:neural:distributed": "node scripts/train_neural_ai_distributed.js",
    "train:neural:evolutionary": "node scripts/train_neural_ai_evolutionary.js",
    "test:neural": "node --test test/neural-strategy.test.js test/neural-trainer-recovery.test.js test/neural-training-commit.test.js test/neural-gpu-gui.test.js test/neural-exact-cuda-parity.test.js",
    "train:neural:gui": "node scripts/neural_trainer_gui.js",
    "test:neural:exact": "node --test test/neural-exact-cuda-parity.test.js",
    "test:games:100": "node scripts/validate_100_full_games.js",
    "test:cpp:parity": "node native/hex-core/core_parity.js --count 100",
    "test:neural:cuda-parity": "node scripts/cuda-exact/exact_parity.js --backend cuda --count 500"
  },
  "dependencies": {
    "ws": "8.22.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
