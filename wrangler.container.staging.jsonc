{
  "$schema": "./cloudflare/node_modules/wrangler/config-schema.json",
  "name": "hex-settlers-cloudflare-staging",
  "main": "cloudflare/container-worker.mjs",
  "compatibility_date": "2026-11-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "HexGameContainer",
      "image": "./cloudflare/Dockerfile",
      "image_build_context": ".",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HEX_BACKEND",
        "class_name": "HexGameContainer"
      }
    ]
  },
  "exports": {
    "HexGameContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "STATE",
      "bucket_name": "hex-settlers-state-staging"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://hex-settlers-cloudflare-staging.bt616923.workers.dev",
    "HEX_EMAIL_FROM": "",
    "ALLOW_EMPTY_DATABASE": "0"
  }
}
